# ============================================================
# 学生选导师系统后端 - 环境变量示例
# ============================================================
# 使用方法：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 修改以下配置项为实际值
#   3. 切勿将 .env 提交到版本控制
# ============================================================

# ============ Django 基础 ============
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=change-me-to-a-random-string-at-least-50-chars
# DEBUG 由 settings 模块决定（dev=True / prod=False），不通过 env 配置
ALLOWED_HOSTS=localhost,127.0.0.1,backend,mentor-backend,your-domain.com
# SSL 重定向：nginx 配置 HTTPS 时设为 true，纯 HTTP 环境设为 false
SECURE_SSL_REDIRECT=false

# ============ MySQL ============
DB_ENGINE=django.db.backends.mysql
DB_NAME=mentor_match
DB_USER=mentor
DB_PASSWORD=change-me-to-strong-password
DB_HOST=mysql
DB_PORT=3306
# 宿主机端口映射（容器内部始终 3306）
# 若本地已有 MySQL 占用 3306，改为 3307 等其他端口
DB_PORT_HOST=3306

# ============ Redis ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============ RabbitMQ ============
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me-to-strong-password
RABBITMQ_VHOST=/

# ============ Celery ============
CELERY_BROKER_URL=amqp://guest:change-me-to-strong-password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ============ JWT ============
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=change-me-to-a-jwt-signing-key

# ============ CORS ============
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://your-domain.com

# ============ Gunicorn（仅 Docker 使用） ============
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# ============ Monitoring（监控服务） ============
# Grafana 管理员账号（首次启动初始化）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-strong-password

# Prometheus 数据保留期（默认 30 天）
PROMETHEUS_RETENTION_TIME=30d

# MySQL Exporter 数据库账号（用于采集 MySQL 指标）
# 生产环境必须创建只读账号，禁止使用主数据库 root/mentor 账号
# CREATE USER 'exporter'@'%' IDENTIFIED BY 'your-password';
# GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'exporter'@'%';
# FLUSH PRIVILEGES;
# 注意：密码仅允许字母数字及 _ @ $ # 等安全字符，禁止包含单引号(')以免破坏 init 脚本 SQL 语法
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=change-me-to-strong-password

# ============ OpenTelemetry 分布式追踪 ============
# 是否启用 OpenTelemetry Auto Instrumentation（true / false）
# 本地开发（无 otel-collector）请设为 false
OTEL_ENABLED=true
# 服务名称（用于 Jaeger 中区分服务）
OTEL_SERVICE_NAME=mentor-backend
# OTLP 导出端点（指向 otel-collector）
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTLP 协议（http/protobuf 或 grpc）
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# 资源属性（服务命名空间 / 版本 / 部署环境）
OTEL_RESOURCE_ATTRIBUTES=service.namespace=mentor-match,service.version=1.0.0,deployment.environment=production
