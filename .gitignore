# Root release-safe ignore (does not ignore backend lib or migrations)
# Env: ignore real env, keep examples
.env
.env.*
!.env.example
!.env*.example

# Python venv
venv/
.venv/
env/
ENV/

# Frontend deps / build
node_modules/
dist/
dist-ssr/
build/
.vite/

# Python build / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage/
htmlcov/

# Logs
/logs/
/mentor-select-backend/logs/
*.log

# DB / SQL dumps (never commit data)
*.sqlite3
*.sql
*.sql.bak
*.dump

# Private / local work (never publish)
work/
.ai/
*.ai.tmp

# Nested git artifacts (preserve histories separately, do not nest-publish)
.git/
**/.git/

# OS / IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# Celery / local runtime
celerybeat-schedule
celerybeat.pid
